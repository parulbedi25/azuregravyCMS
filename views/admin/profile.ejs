<div class="admin-page-head">
  <div>
    <h1>Your profile</h1>
    <p>This is what readers see on your author page and under your posts.</p>
  </div>
  <div class="admin-page-head__actions">
    <a class="btn btn--ghost btn--sm" href="/author/<%= currentUser.id %>" target="_blank" rel="noopener"><%- h.icon('external', '', 14) %> Public profile</a>
  </div>
</div>

<div class="admin-grid-side">
  <form class="panel" method="post" action="/admin/profile">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="panel__head"><h2>Profile details</h2></div>
    <div class="panel__body form-grid">
      <div class="form-grid form-grid--2">
        <label class="field"><span>Name</span><input class="input" name="name" value="<%= currentUser.name %>" required></label>
        <label class="field"><span>Email</span><input class="input" type="email" name="email" value="<%= currentUser.email %>" required></label>
      </div>
      <label class="field"><span>Bio</span><textarea class="textarea" name="bio" rows="4" placeholder="A couple of sentences about you and what you write."><%= currentUser.bio || '' %></textarea></label>
      <div class="form-grid form-grid--2">
        <label class="field"><span>Website</span><input class="input" name="website" value="<%= currentUser.website || '' %>" placeholder="https://"></label>
        <label class="field"><span>Twitter / X</span><input class="input" name="twitter" value="<%= currentUser.twitter || '' %>" placeholder="handle"></label>
      </div>
      <div class="form-grid form-grid--2">
        <label class="field"><span>LinkedIn</span><input class="input" name="linkedin" value="<%= currentUser.linkedin || '' %>" placeholder="https://linkedin.com/in/…"></label>
        <label class="field"><span>Avatar URL</span><input class="input" name="avatar" value="<%= currentUser.avatar || '' %>" placeholder="/uploads/…"></label>
      </div>
      <div class="row row--between">
        <span class="text-xs text-muted">Role: <b style="text-transform:capitalize"><%= currentUser.role %></b> — ask an admin to change it.</span>
        <button class="btn btn--accent btn--sm" type="submit"><%- h.icon('save', '', 14) %> Save profile</button>
      </div>
    </div>
  </form>

  <div class="stack-16">
    <div class="panel">
      <div class="panel__head"><h2>Change password</h2></div>
      <form class="panel__body form-grid" method="post" action="/admin/profile/password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <label class="field"><span>Current password</span><input class="input" type="password" name="current_password" required autocomplete="current-password"></label>
        <label class="field"><span>New password</span><input class="input" type="password" name="new_password" required minlength="8" autocomplete="new-password"></label>
        <label class="field"><span>Confirm new password</span><input class="input" type="password" name="confirm_password" required minlength="8" autocomplete="new-password"></label>
        <button class="btn btn--ghost btn--sm" type="submit"><%- h.icon('key', '', 14) %> Update password</button>
      </form>
    </div>

    <%#
      A member's own AI key.

      Rendered only for somebody an administrator granted access to, and never for
      an administrator — they compose with the site-wide provider and configure it
      under Studio → AI assistant, so a second control here would only contradict
      the first.

      There is deliberately no base URL input. The member picks a provider an
      administrator approved and the route looks the endpoint up server-side, so
      the credential is theirs but the destination is not. Without that, anybody
      granted access could point the CMS at an endpoint they control and read
      every draft routed through it.

      `typeof` because EJS compiles inside `with(locals)`, where an unpassed local
      is a ReferenceError rather than undefined.
    %>
    <% const ai = typeof aiAccess !== 'undefined' && aiAccess ? aiAccess : null; %>
    <% if (ai && !ai.isAdmin && ai.canSee) { %>
      <div class="panel">
        <div class="panel__head">
          <h2>AI assistant</h2>
          <span class="pill <%= ai.canCompose ? 'pill--published' : 'pill--draft' %>">
            <%= ai.canCompose ? 'ready' : 'needs a model' %>
          </span>
        </div>
        <% if (ai.canSelfServe) { %>
          <form class="panel__body form-grid" method="post" action="/admin/profile/ai">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <p class="text-sm text-muted" style="margin-top:0"><%= ai.reason %></p>

            <label class="field">
              <span>Provider</span>
              <select class="select" name="ai_preset">
                <% ai.approvedPresets.forEach(function (p) { %>
                  <option value="<%= p.id %>" <%= ai.presetId === p.id ? 'selected' : '' %>>
                    <%= p.label %> — <%= p.requiresKey ? (p.free ? 'free, key needed' : 'paid') : 'no key needed' %>
                  </option>
                <% }); %>
              </select>
              <span class="hint">Only providers an administrator approved. Your key travels from this server to that provider and nowhere else.</span>
            </label>

            <label class="field">
              <span>Model</span>
              <input class="input mono" type="text" name="ai_model" value="<%= ai.model %>" placeholder="Leave blank for the provider's default">
            </label>

            <label class="field">
              <span>Your API key</span>
              <input class="input mono" type="password" name="ai_api_key" autocomplete="new-password"
                placeholder="<%= ai.maskedKey ? 'Saved ' + ai.maskedKey + ' — leave blank to keep it' : 'Paste your key' %>">
              <span class="hint">Stored so this server can call the provider on your behalf. Never displayed again — the mask above is all that is ever shown.</span>
            </label>

            <% if (ai.hasKey) { %>
              <label class="switch">
                <input type="checkbox" name="ai_key_clear" value="1">
                <span class="switch__track"></span>
                <span class="switch__text">
                  <b>Remove my saved key</b>
                  <span>Switch on to stop sending a credential at all — useful when moving to a provider that needs no key.</span>
                </span>
              </label>
            <% } %>

            <button class="btn btn--accent btn--sm" type="submit"><%- h.icon('save', '', 14) %> Save my AI provider</button>
          </form>
        <% } else { %>
          <div class="panel__body">
            <p class="text-sm text-muted" style="margin:0"><%= ai.reason %></p>
            <p class="text-sm text-muted" style="margin:10px 0 0">
              <% if (ai.approvedPresets.length) { %>
                An administrator manages your AI configuration, so there is nothing for you to change here.
              <% } else { %>
                No provider has been approved for members to bring their own key to yet. Ask an administrator either to
                assign you a model, or to approve a provider under Studio → AI assistant.
              <% } %>
            </p>
          </div>
        <% } %>
      </div>
    <% } %>

    <div class="panel">
      <div class="panel__body" style="display:grid;gap:12px;justify-items:start">
        <%- include('../partials/avatar', { avatar: currentUser.avatar, name: currentUser.name, size: 'xl' }) %>
        <div>
          <b style="display:block"><%= currentUser.name %></b>
          <span class="text-xs text-muted">Joined <%= h.formatDate(currentUser.created_at, 'medium') %></span>
        </div>
        <p class="text-xs text-muted" style="margin:0">Signed in as <b><%= currentUser.email %></b></p>
      </div>
    </div>
  </div>
</div>
