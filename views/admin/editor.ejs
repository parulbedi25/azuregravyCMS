<%
  const isPage = type === 'page';
  /*
    URL chrome around the slug, taken from the permalink structure in force.
    Pages always sit at the root. For a post both halves can move: the prefix
    carries any base or date segments, and the suffix exists because a
    structure is allowed to put segments *after* the slug. An unsaved post has
    no publish date yet, so the date tokens preview against today.
  */
  const affixes = h.permalinkAffixes(post ? post : { slug: '', type: type });
  const base = affixes.prefix;
  const baseSuffix = affixes.suffix;
  const selectedCategoryIds = (post && post.categories ? post.categories.map(function (c) { return c.id; }) : []);
  const tagValue = post && post.tags ? post.tags.map(function (t) { return t.name; }).join(', ') : '';
  const status = post ? post.status : 'draft';
  const featured = post && post.featured_image_id ? post.featured_image_id : '';
  const featuredPath = post && post.featured_image ? post.featured_image : '';
%>

<form id="editorForm" method="post"
      action="<%= post && post.id ? '/admin/posts/' + post.id : '/admin/posts' %>"
      data-post-id="<%= post && post.id ? post.id : 'new' %>">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="type" value="<%= type %>">
  <input type="hidden" name="intent" id="intentField" value="save">

  <div class="admin-page-head">
    <div>
      <div class="row" style="gap:8px;margin-bottom:4px">
        <a class="text-xs text-muted" href="/admin/posts?type=<%= type %>">← All <%= isPage ? 'pages' : 'posts' %></a>
        <% if (post && post.id) { %>
          <% if (post.status === 'published') { %>
            <span class="text-xs text-muted">·</span>
            <a class="text-xs text-muted" href="<%= h.postUrl(post) %>" target="_blank" rel="noopener">View live ↗</a>
          <% } %>
          <span class="text-xs text-muted">·</span>
          <a class="text-xs text-muted" href="/admin/posts/<%= post.id %>/revisions"><%= revisions.length %> revision<%= revisions.length === 1 ? "" : "s" %></a>
        <% } %>
      </div>
      <h1><%= post && post.id ? 'Edit ' + (isPage ? 'page' : 'post') : 'New ' + (isPage ? 'page' : 'post') %></h1>
      <p><span id="saveState"><%= post && post.updated_at ? 'Last edited ' + h.timeAgo(post.updated_at) : 'Not saved yet' %></span></p>
    </div>
    <div class="admin-page-head__actions">
      <button class="btn btn--ghost btn--sm" type="submit" data-save-button data-intent="save">Save changes</button>
      <% if (can.editor || (post && post.author_id === currentUser.id)) { %>
        <button class="btn btn--accent btn--sm" type="submit" data-intent="publish"><%- h.icon('send', '', 14) %> <%= post && post.status === 'published' ? 'Update' : 'Publish' %></button>
      <% } %>
    </div>
  </div>

  <div class="editor-shell">
    <div class="editor-main">
      <div class="panel">
        <input class="editor-title" id="title" name="title" type="text" required
               placeholder="<%= isPage ? 'Page title' : 'Post title…' %>" value="<%= post ? post.title : '' %>" autocomplete="off">
        <% if (post && post.id && post.status !== 'trash') { %>
          <%
            // Mirrors the server-side rule in the /preview/:ref route: the author
            // of the piece, or a super admin. Not editors, not other authors.
            const canPreview = !!currentUser
              && (currentUser.role === 'admin' || post.author_id === currentUser.id);
          %>
          <div class="editor-titlelink">
            <% if (post.status === 'published') { %>
              <a href="<%= h.postUrl(post) %>" target="_blank" rel="noopener noreferrer">
                <%- h.icon('external', '', 12) %> View live <%= isPage ? 'page' : 'post' %>
              </a>
              <code class="editor-titlelink__url"><%= h.postUrl(post) %></code>
            <% } else if (canPreview) { %>
              <a href="<%= h.previewUrl(post) %>" target="_blank" rel="noopener noreferrer">
                <%- h.icon('eye', '', 12) %> Preview <%= post.status %>
              </a>
              <span class="editor-titlelink__note">
                Private link — opens in a new tab, visible only to you and site admins.
              </span>
            <% } %>
          </div>
        <% } %>
        <div class="slug-row">
          <%- h.icon('link', '', 13) %>
          <span><%= base %></span>
          <input class="input" id="slug" name="slug" type="text" value="<%= post ? post.slug : '' %>" placeholder="auto-generated-from-title" style="max-width: 320px">
          <% if (baseSuffix) { %><span><%= baseSuffix %></span><% } %>
          <label class="checkbox text-xs" style="margin-left:6px">
            <input type="checkbox" id="slugLocked" checked> Auto
          </label>
        </div>

        <div class="editor-toolbar">
          <div class="tool-group">
            <button class="tool" type="button" data-insert="bold" title="Bold"><%- h.icon('bold', '', 15) %></button>
            <button class="tool" type="button" data-insert="italic" title="Italic"><%- h.icon('italic', '', 15) %></button>
            <button class="tool" type="button" data-insert="h2" title="Heading 2"><%- h.icon('heading', '', 15) %></button>
            <button class="tool" type="button" data-insert="quote" title="Quote"><%- h.icon('quote', '', 15) %></button>
          </div>
          <span class="divider-v"></span>
          <div class="tool-group">
            <button class="tool" type="button" data-insert="ul" title="Bullet list"><%- h.icon('list-ul', '', 15) %></button>
            <button class="tool" type="button" data-insert="ol" title="Numbered list"><%- h.icon('list-ol', '', 15) %></button>
            <button class="tool" type="button" data-insert="link" title="Link"><%- h.icon('link', '', 15) %></button>
            <button class="tool" type="button" data-insert="image" title="Image"><%- h.icon('image', '', 15) %></button>
            <button class="tool" type="button" data-insert="code" title="Code block"><%- h.icon('code', '', 15) %></button>
            <button class="tool" type="button" data-insert="hr" title="Divider"><%- h.icon('minus', '', 15) %></button>
          </div>

          <div class="editor-tabs">
            <button type="button" data-editor-tab="write" class="is-active">Write</button>
            <button type="button" data-editor-tab="preview">Preview</button>
          </div>

          <span class="editor-toolbar__right">
            <span class="text-xs text-muted" style="margin-right:6px">Markdown</span>
          </span>
        </div>

        <div class="editor-panes">
          <div class="editor-pane is-active" id="paneWrite">
            <textarea class="editor-textarea" id="content" name="content" spellcheck="true"
                      placeholder="Start with a sentence.&#10;&#10;Use ## for section headings, > for quotes, and - for lists. Paste images from the media library with ![alt](/uploads/file.webp)."><%= post ? post.content : '' %></textarea>
          </div>
          <div class="editor-pane editor-preview" id="panePreview">
            <div id="editorPreview"><div class="editor-preview__empty">Start writing — the preview will build itself.</div></div>
          </div>
        </div>

        <div class="editor-foot">
          <span id="wordCount">0 words</span>
          <span>·</span>
          <span id="readTime">1 min read</span>
          <span>·</span>
          <span id="charCount">0 characters</span>
          <span class="spacer"></span>
          <span>⌘S to save</span>
        </div>
      </div>

      <div class="panel">
        <div class="panel__head">
          <div><h2>Excerpt &amp; SEO</h2><p>How this <%= isPage ? 'page' : 'post' %> appears in search and social.</p></div>
        </div>
        <div class="panel__body">
          <div class="form-grid">
            <label class="field">
              <span>Excerpt</span>
              <textarea class="textarea" name="excerpt" rows="3" placeholder="A sentence or two that makes someone want to read on. Leave blank to auto-generate from the first paragraph."><%= post && post.excerpt ? post.excerpt : '' %></textarea>
            </label>

            <div class="form-grid form-grid--2">
              <label class="field">
                <span class="label-row"><span>SEO title</span><span class="counter" id="seoTitleCount"></span></span>
                <input class="input" type="text" name="seo_title" value="<%= post && post.seo_title ? post.seo_title : '' %>"
                       placeholder="Defaults to the post title" data-counter="seoTitleCount" data-ideal="30" data-max="60">
              </label>
              <label class="field">
                <span>Social image</span>
                <div class="row">
                  <input class="input" type="hidden" id="og_image_id" name="og_image_id" value="<%= post && post.og_image_id ? post.og_image_id : '' %>">
                  <button class="btn btn--soft btn--sm" type="button" data-pick-media="og_image_id"><%- h.icon('image', '', 14) %> Choose image</button>
                  <img id="og_image_id-preview" alt="" style="width:36px;height:28px;object-fit:cover;border-radius:5px;<%= post && post.og_image_id ? '' : 'display:none' %>" src="">
                </div>
              </label>
            </div>

            <label class="field">
              <span class="label-row"><span>SEO description</span><span class="counter" id="seoDescCount"></span></span>
              <textarea class="textarea" name="seo_description" rows="2" placeholder="The one-liner search engines show under the title."
                        data-counter="seoDescCount" data-ideal="70" data-max="160"><%= post && post.seo_description ? post.seo_description : '' %></textarea>
            </label>

            <div class="seo-preview">
              <span><%= settings.site_url || 'https://your-domain.com' %><%= base %><span id="seoSlug"><%= post ? post.slug : 'your-post' %></span><%= baseSuffix %></span>
              <b><%= post && post.seo_title ? post.seo_title : (post ? post.title : 'Your post title') %></b>
              <p><%= post && post.seo_description ? post.seo_description : 'A short description of the post, shown under the title in search results.' %></p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <aside class="editor-side">
      <div class="side-card">
        <div class="side-card__head"><h3>Publishing</h3><span class="pill pill--<%= status %>"><%= status %></span></div>
        <div class="side-card__body">
          <label class="field">
            <span class="label">Status</span>
            <select class="select" name="status">
              <option value="draft" <%= status === 'draft' ? 'selected' : '' %>>Draft</option>
              <option value="published" <%= status === 'published' ? 'selected' : '' %>>Published</option>
              <option value="scheduled" <%= status === 'scheduled' ? 'selected' : '' %>>Scheduled</option>
              <option value="private" <%= status === 'private' ? 'selected' : '' %>>Private</option>
              <% if (status === 'trash') { %><option value="trash" selected>Trash</option><% } %>
            </select>
          </label>
          <label class="field">
            <span class="label">Date &amp; time (UTC)</span>
            <input class="input input-sm" type="datetime-local" name="published_at" value="<%= post ? h.toLocalInput(post.published_at) : '' %>">
            <span class="hint">Set a future date with “Scheduled” to publish automatically.</span>
          </label>
          <% if (can.editor) { %>
            <label class="field">
              <span class="label">Author</span>
              <select class="select" name="author_id">
                <% users.forEach(function (user) { %>
                  <option value="<%= user.id %>" <%= post && post.author_id === user.id ? 'selected' : (!post && user.id === currentUser.id ? 'selected' : '') %>><%= user.name %></option>
                <% }); %>
              </select>
            </label>
          <% } %>
          <% if (isPage) { %>
            <label class="field">
              <span class="label">Template</span>
              <select class="select" name="template">
                <option value="default" <%= post && post.template === 'default' ? 'selected' : '' %>>Default page</option>
                <option value="contact" <%= post && post.template === 'contact' ? 'selected' : '' %>>Contact page</option>
              </select>
            </label>
          <% } %>
          <label class="switch">
            <input type="checkbox" name="is_sticky" <%= post && post.is_sticky ? 'checked' : '' %>>
            <span class="switch__track"></span>
            <span class="switch__text"><b>Featured</b><span>Pin to the top of the home page.</span></span>
          </label>
          <label class="switch">
            <input type="checkbox" name="allow_comments" <%= !post || post.allow_comments ? 'checked' : '' %>>
            <span class="switch__track"></span>
            <span class="switch__text"><b>Comments</b><span>Allow readers to reply.</span></span>
          </label>

          <div class="publish-actions" style="margin-top:4px">
            <button class="btn btn--accent btn--block btn--sm" type="submit" data-intent="publish">
              <%- h.icon('send', '', 14) %> <%= post && post.status === 'published' ? 'Update post' : 'Publish' %>
            </button>
            <button class="btn btn--ghost btn--block btn--sm" type="submit" data-intent="save">Save draft</button>
          </div>

          <% if (post && post.id) { %>
            <div class="publish-meta" style="margin-top:6px;padding-top:10px;border-top:1px solid var(--admin-line)">
              <div><span>Created</span><b><%= h.formatDate(post.created_at, 'medium') %></b></div>
              <div><span>Updated</span><b><%= h.timeAgo(post.updated_at) %></b></div>
              <div><span>Views</span><b><%= h.formatNumber(post.views) %></b></div>
              <div><span>Comments</span><b><%= post.comment_count || 0 %></b></div>
            </div>
            <% /* The forms themselves live after </form> below — see the note there. */ %>
            <% if (post.status === 'trash') { %>
              <button class="btn btn--ghost btn--sm btn--block" type="submit" form="restorePostForm"
                      style="margin-top:6px"
                      data-confirm="Restore this <%= isPage ? 'page' : 'post' %> out of the trash?"><%- h.icon('refresh', '', 13) %> Restore from trash</button>
              <% if (canDelete) { %>
                <button class="btn btn--ghost btn--sm btn--block" type="submit" form="purgePostForm"
                        style="margin-top:6px;color:#c0392b"
                        data-confirm="Delete this <%= isPage ? 'page' : 'post' %> permanently? This cannot be undone."><%- h.icon('x-circle', '', 13) %> Delete permanently</button>
              <% } %>
            <% } else { %>
              <button class="btn btn--ghost btn--sm btn--block" type="submit" form="deletePostForm"
                      style="margin-top:6px;color:#c0392b"
                      data-confirm="Move this <%= isPage ? 'page' : 'post' %> to trash?"><%- h.icon('trash', '', 13) %> Move to trash</button>
            <% } %>
          <% } %>
        </div>
      </div>

      <%
        /*
          AI drafting card — for whoever an administrator granted access to.

          Deliberately not a <form>, and deliberately no name= attributes: this
          card lives inside #editorForm, so a nested form would be invalid HTML
          (browser recovery then duplicates _csrf, which is what caused the
          publish-419 bug) and any named input would be posted with the post.
          Everything is read by id and sent with fetch. Buttons are
          type="button" so they can never submit the post form.

          `typeof` rather than a bare reference: EJS compiles inside
          `with(locals)`, so an unpassed local is a ReferenceError, not undefined.
          This view is only rendered from inside the admin router, which resolves
          the entitlement, but the guard costs nothing and keeps a future render
          path from turning into a 500.
        */
        /*
          Named `aiEntitlement`, NOT `aiAccess`: EJS compiles the template inside
          `with(locals)`, and `const aiAccess = typeof aiAccess …` shadows the
          very binding it reads, which puts it in the temporal dead zone so
          `typeof` throws "Cannot access before initialization" instead of
          returning 'undefined'. The guard is only safe while the declared name
          differs from the local it inspects.
        */
        const aiEntitlement = typeof aiAccess !== 'undefined' && aiAccess ? aiAccess : null;
        // canSee is the administrator's decision about this person; canCompose is
        // whether they hold anything usable. The second can be false while the
        // first is true — entitled, but no model assigned yet — and the card then
        // explains that instead of quietly spending the site-wide key.
        const aiVisible = !!aiEntitlement && aiEntitlement.canSee;
        const aiReady = !!aiEntitlement && aiEntitlement.canCompose;
        const aiReason = aiEntitlement ? aiEntitlement.reason : h.aiStatus.reason;
        const aiSeedTitle = post && post.title ? post.title : '';
      %>
      <% if (aiVisible) { %>
      <div class="side-card side-card--collapsible side-card--open side-card--ai">
        <div class="side-card__head">
          <h3><%- h.icon('sparkles', '', 13) %> AI assistant</h3>
          <span class="side-card__toggle"><%- h.icon('chevron-down', '', 15) %></span>
        </div>
        <div class="side-card__body">
          <% if (!aiReady) { %>
            <p class="hint" style="margin:0">
              <%# aiReason is the shared readiness sentence: accurate for a
                  missing model, a key-needing provider with no key, or the
                  assistant being off — none of which is "add an API key".

                  Where the link goes depends on who is reading. An administrator
                  can change the provider; a member can only ever change their
                  own key; and a member with no approved provider has nothing
                  they can do themselves, so they get no dead link to a page that
                  would answer 403 anyway. %>
              <%= aiReason %>
              <% if (aiEntitlement.isAdmin) { %>
                <a href="/admin/ai">Configure it</a>, or use the switch in the sidebar.
              <% } else if (aiEntitlement.canSelfServe) { %>
                <a href="/admin/profile">Add your own key</a> on your profile.
              <% } %>
            </p>
          <% } else { %>
            <label class="field">
              <span class="label">Title</span>
              <input class="input" type="text" id="aiTitle" value="<%= aiSeedTitle %>" placeholder="What is the post about?" autocomplete="off">
            </label>

            <label class="field">
              <span class="label">How much should it write?</span>
              <select class="input" id="aiMode">
                <option value="title">Title</option>
                <option value="full">Post</option>
                <option value="image">Feature Image</option>
                <option value="title_post_image">Title + Post + Feature Image</option>
                <option value="continue">Continue from where I am</option>
                <option value="selection">Rewrite my selection</option>
                <option value="outline">An outline only</option>
              </select>
            </label>

            <div class="form-grid form-grid--2">
              <label class="field">
                <span class="label">Length</span>
                <select class="input" id="aiLength">
                  <option value="short">Short</option>
                  <option value="medium" selected>Medium</option>
                  <option value="long">Long</option>
                </select>
              </label>
              <label class="field">
                <span class="label">Tone</span>
                <input class="input" type="text" id="aiTone" placeholder="optional" autocomplete="off">
              </label>
            </div>

            <p class="hint" style="margin:0">Diagrams are drawn into the draft where the subject is genuinely structural.</p>

            <button class="btn btn--accent btn--sm btn--block" type="button" id="aiGenerate">
              <%- h.icon('sparkles', '', 14) %> <span data-ai-cta>Write it</span>
            </button>
            <p class="hint" id="aiStatus" role="status" aria-live="polite" style="margin:0;display:none"></p>

            <%#
              Headline picker for the "whole article + title ideas" mode. Filled
              from the compose response by the script at the foot of this view,
              and kept hidden until there is something to choose. Picking one
              writes the editor's own Title field, which stays a normal input, so
              the title can always be changed there afterwards.
            %>
            <div id="aiTitlePicker" hidden>
              <span class="label">Choose a title</span>
              <div class="ai-titles" id="aiTitleList" role="radiogroup" aria-label="Suggested titles"></div>
              <p class="hint" style="margin:0">The one you pick fills the Title field at the top of the editor, where you can still change it.</p>
            </div>
          <% } %>
        </div>
      </div>
      <% } %>

      <div class="side-card side-card--collapsible side-card--open">
        <div class="side-card__head"><h3>Categories</h3><span class="side-card__toggle"><%- h.icon('chevron-down', '', 15) %></span></div>
        <div class="side-card__body">
          <div class="checklist">
            <% categories.forEach(function (category) { %>
              <label>
                <input type="checkbox" name="categories" value="<%= category.id %>" <%= selectedCategoryIds.includes(category.id) ? 'checked' : '' %>>
                <span><%= category.name %></span>
                <span class="text-xs text-muted" style="margin-left:auto"><%= category.post_count || 0 %></span>
              </label>
            <% }); %>
          </div>
          <a class="text-xs" href="/admin/categories" style="color:var(--admin-accent)">Manage categories →</a>
        </div>
      </div>

      <div class="side-card side-card--collapsible side-card--open">
        <div class="side-card__head"><h3>Tags</h3><span class="side-card__toggle"><%- h.icon('chevron-down', '', 15) %></span></div>
        <div class="side-card__body">
          <input type="hidden" name="tags" id="tagsValue" value="<%= tagValue %>">
          <div class="tag-input" id="tagInput">
            <span id="tagChips" style="display:contents"></span>
            <input type="text" id="tagEntry" placeholder="Add a tag…" aria-label="Add a tag">
          </div>
          <span class="hint">Press Enter or comma to add. Up to 20 tags.</span>
          <div class="tag-cloud" style="gap:5px">
            <% tags.slice(0, 8).forEach(function (tag) { %>
              <button type="button" class="chip" style="font-size:.68rem;text-transform:none;letter-spacing:0" data-add-tag="<%= tag.name %>">#<%= tag.name %></button>
            <% }); %>
          </div>
        </div>
      </div>

      <div class="side-card">
        <div class="side-card__head"><h3>Featured image</h3></div>
        <div class="side-card__body">
          <input type="hidden" id="featured_image_id" name="featured_image_id" value="<%= featured %>">
          <%
            /*
              One preview <img> is always in the DOM and CSS decides whether it is
              visible, keyed off .has-image on the wrapper. The previous markup
              branched server-side and gave the empty state an inline
              style="display:none" that admin.js never cleared — so choosing an
              image on an unsaved post updated src but left it invisible until
              the page reloaded.
            */
            const quickPicks = media.filter(function (m) { return /^image\//.test(m.mime_type || ''); }).slice(0, 4);
          %>
          <div class="image-picker <%= featuredPath ? 'has-image' : '' %>">
            <img id="featured_image_id-preview" src="<%= featuredPath %>" alt="">
            <span class="image-picker__empty">
              <%- h.icon('image-plus', '', 22) %>
              <span>No image selected</span>
            </span>
            <span class="image-picker__actions">
              <button type="button" data-pick-media="featured_image_id" title="Browse library"><%- h.icon('image', '', 13) %></button>
              <button type="button" data-remove-media="featured_image_id" title="Remove image"><%- h.icon('close', '', 13) %></button>
            </span>
          </div>
          <% if (quickPicks.length) { %>
            <div class="quick-picks">
              <% quickPicks.forEach(function (item) { %>
                <button type="button"
                        class="quick-pick <%= String(item.id) === String(featured) ? 'is-selected' : '' %>"
                        data-quick-pick="featured_image_id"
                        data-id="<%= item.id %>"
                        data-path="<%= item.path %>"
                        title="<%= item.original_name || 'Use this image' %>"
                        aria-label="Use this image as the featured image"
                        aria-pressed="<%= String(item.id) === String(featured) ? 'true' : 'false' %>">
                  <img src="<%= item.path %>" alt="" loading="lazy">
                </button>
              <% }); %>
            </div>
          <% } %>
          <span class="hint">
            <% if (quickPicks.length) { %>
              Click a thumbnail to use it straight away, or browse the full library.
            <% } else { %>
              No images in the library yet — upload one to set a featured image.
            <% } %>
          </span>
        </div>
      </div>

      <% if (revisions.length) { %>
        <div class="side-card side-card--collapsible">
          <div class="side-card__head"><h3>Revision history</h3><span class="side-card__toggle"><%- h.icon('chevron-down', '', 15) %></span></div>
          <div class="side-card__body">
            <ul class="revision-list">
              <% revisions.slice(0, 6).forEach(function (revision) { %>
                <li>
                  <span class="flex-1 truncate"><%= revision.title %></span>
                  <time><%= h.timeAgo(revision.created_at) %></time>
                  <button class="row-action" type="submit" title="Restore"
                          form="restoreRevisionForm-<%= revision.id %>"
                          data-confirm="Restore this revision?"><%- h.icon('undo', '', 13) %></button>
                </li>
              <% }); %>
            </ul>
            <a class="text-xs" href="/admin/posts/<%= post.id %>/revisions" style="color:var(--admin-accent)">All revisions →</a>
          </div>
        </div>
      <% } %>
    </aside>
  </div>
</form>

<%
  /*
    These action forms live OUTSIDE #editorForm on purpose, and the buttons above
    reach them through the HTML5 `form` attribute.

    They used to be nested inside #editorForm, which is invalid HTML, and the
    parser's error recovery made that actively destructive: an inner <form> start
    tag is dropped when a form is already open, but its </form> is still honoured
    and closes the *outer* form. So the "Move to trash" form's </form> terminated
    #editorForm early, which meant

      1. every field after it — categories, tags, featured_image_id — sat outside
         the form and was silently discarded when saving an existing post, and
      2. the absorbed hidden _csrf input gave #editorForm two fields of that name.
         A duplicate key parses to an array, verifyCsrf() requires a string, and
         the submit failed with a misleading "419 Session expired".

    Only the existing-post path rendered those nested forms, which is why creating
    a post worked while publishing or updating one did not.
  */
%>
<% if (post && post.id) { %>
  <form id="deletePostForm" method="post" action="/admin/posts/<%= post.id %>/delete">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="redirect" value="/admin/posts?type=<%= type %>">
  </form>
  <form id="restorePostForm" method="post" action="/admin/posts/<%= post.id %>/restore">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="redirect" value="/admin/posts?type=<%= type %>">
  </form>
  <% /* Only render the purge form for roles that may actually use it — the
        button above is gated the same way, and the server enforces it too. */ %>
  <% if (canDelete) { %>
    <form id="purgePostForm" method="post" action="/admin/posts/<%= post.id %>/delete">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="mode" value="permanent">
      <input type="hidden" name="redirect" value="/admin/posts?type=<%= type %>&status=trash">
    </form>
  <% } %>
<% } %>
<% if (revisions.length) { %>
  <% revisions.slice(0, 6).forEach(function (revision) { %>
    <form id="restoreRevisionForm-<%= revision.id %>" method="post"
          action="/admin/posts/<%= post.id %>/revisions/<%= revision.id %>/restore">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    </form>
  <% }); %>
<% } %>

<script>
  document.addEventListener('click', function (event) {
    var addTag = event.target.closest('[data-add-tag]');
    if (!addTag) return;
    var hidden = document.getElementById('tagsValue');
    var chips = document.getElementById('tagChips');
    var entry = document.getElementById('tagEntry');
    var tags = (hidden.value || '').split(',').map(function (t) { return t.trim(); }).filter(Boolean);
    if (!tags.some(function (t) { return t.toLowerCase() === addTag.dataset.addTag.toLowerCase(); })) {
      tags.push(addTag.dataset.addTag);
      hidden.value = tags.join(', ');
      chips.innerHTML = tags.map(function (tag, index) {
        return '<span class="tag-input__chip">' + tag.replace(/</g, '&lt;') + '<button type="button" data-remove-tag="' + index + '" aria-label="Remove tag">✕</button></span>';
      }).join('');
    }
  });
</script>

<%# Gated on exactly the same condition as the card above. If these ever drift,
    the script runs against elements that are not there, or the card renders with
    a dead Generate button — both silent, both confusing. %>
<% if (aiVisible) { %>
<script>
  /*
    AI drafting panel — for whoever an administrator granted access to.

    Talks to /admin/ai/compose over fetch with the x-csrf-token header, the same
    contract admin.js already uses. Nothing here is a form control with a name,
    so none of it can be submitted with the post, and the generate button is
    type="button" so it can never trigger the editor form.
  */
  (function () {
    var button = document.getElementById('aiGenerate');
    if (!button) return;

    var titleInput = document.getElementById('aiTitle');
    var modeSelect = document.getElementById('aiMode');
    var lengthSelect = document.getElementById('aiLength');
    var toneInput = document.getElementById('aiTone');
    var status = document.getElementById('aiStatus');
    var cta = button.querySelector('[data-ai-cta]');
    var textarea = document.getElementById('content');
    var csrfField = document.querySelector('#editorForm input[name="_csrf"]');
    var csrf = csrfField ? csrfField.value : '';
    var picker = document.getElementById('aiTitlePicker');
    var pickerList = document.getElementById('aiTitleList');
    var postTitle = document.getElementById('title');

    /*
      What each mode touches, declared once. Scattered `mode === 'x'` compares
      are how a mode ends up half-handled when the list grows.
    */
    var REPLACES_BODY = { full: 1, outline: 1, title_post_image: 1 };
    var WRITES_BODY   = { full: 1, outline: 1, continue: 1, selection: 1, title_post_image: 1 };
    var OFFERS_TITLES = { title: 1, title_post_image: 1 };
    var WANTS_IMAGE   = { image: 1, title_post_image: 1 };

    function say(message, kind) {
      if (!status) return;
      status.textContent = message;
      status.style.display = message ? 'block' : 'none';
      status.style.color = kind === 'error' ? '#c0392b' : '';
    }

    function setBusy(on) {
      button.disabled = on;
      if (cta) cta.textContent = on ? 'Writing…' : 'Write it';
    }

    function insert(markdown, mode, selStart, selEnd) {
      if (!textarea) return;
      var next;
      if (mode === 'continue') {
        var existing = textarea.value.replace(/\s+$/, '');
        next = existing ? existing + '\n\n' + markdown : markdown;
      } else if (mode === 'selection') {
        next = textarea.value.slice(0, selStart) + markdown + textarea.value.slice(selEnd);
      } else {
        next = markdown;
      }
      textarea.value = next;
      /*
        Assigning .value does not fire `input`, and admin.js depends on that
        event for the live preview, the word count and unsaved-change tracking.
        Without this the draft would be in the textarea but the preview blank.
      */
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
      textarea.focus();
    }

    /*
      Headline picker. Rebuilt from nothing on every generate, so a headline
      chosen for an earlier draft can never be applied to a later one.
    */
    function clearTitles() {
      if (!picker || !pickerList) return;
      pickerList.innerHTML = '';
      picker.hidden = true;
    }

    function renderTitles(suggestions) {
      if (!picker || !pickerList) return;
      pickerList.innerHTML = '';
      if (!postTitle || !suggestions || !suggestions.length) { picker.hidden = true; return; }

      suggestions.forEach(function (text) {
        var option = document.createElement('button');
        option.type = 'button';               /* never able to submit #editorForm */
        option.className = 'ai-titles__item';
        option.setAttribute('role', 'radio');
        option.setAttribute('aria-checked', 'false');
        option.textContent = text;            /* textContent: model output is never parsed as HTML */

        option.addEventListener('click', function () {
          var items = pickerList.querySelectorAll('.ai-titles__item');
          for (var i = 0; i < items.length; i += 1) items[i].setAttribute('aria-checked', 'false');
          option.setAttribute('aria-checked', 'true');

          postTitle.value = text;
          /*
            admin.js listens for `input` on the title to regenerate a locked slug
            and to track unsaved changes. Assigning .value fires neither, so
            without this the slug would keep the old title's.
          */
          postTitle.dispatchEvent(new Event('input', { bubbles: true }));

          say('Title set to “' + text + '”. Change it in the Title field any time.', 'ok');
          if (window.GravyStudio) window.GravyStudio.toast('Title applied.', 'success');
        });

        pickerList.appendChild(option);
      });

      picker.hidden = false;
    }

    /*
      Mirror admin.js's applyMediaSelection. That function lives inside admin.js's
      closure and is not exported, so this is the only way to set the featured
      image without a page reload — and it has to match, or the two ways of
      choosing an image would leave the panel in different states.

      All three steps are load-bearing: the hidden field that actually posts, the
      permanent preview <img>, and the .has-image class on the wrapper, which is
      what drives visibility (never an inline display:none — see the comment on
      the picker markup above).
    */
    function applyImage(image) {
      if (!image) return false;
      var field = document.getElementById('featured_image_id');
      if (field) field.value = String(image.mediaId);

      var preview = document.getElementById('featured_image_id-preview');
      if (preview) {
        preview.src = image.url || '';
        preview.style.display = '';
        preview.hidden = false;
      }
      var wrap = preview && preview.closest ? preview.closest('.image-picker') : null;
      if (wrap) wrap.classList.toggle('has-image', !!image.url);

      /* An AI image is not one of the quick-pick thumbnails, so none is selected. */
      var quick = document.querySelectorAll('[data-quick-pick="featured_image_id"]');
      for (var i = 0; i < quick.length; i += 1) {
        quick[i].classList.remove('is-selected');
        quick[i].setAttribute('aria-pressed', 'false');
      }
      return true;
    }

    async function generate() {
      if (button.disabled) return;

      var title = (titleInput ? titleInput.value : '').trim();
      if (title.length < 3) {
        say('Give the assistant a title of at least three characters.', 'error');
        if (titleInput) titleInput.focus();
        return;
      }

      var mode = modeSelect ? modeSelect.value : 'full';
      var selStart = textarea ? textarea.selectionStart : 0;
      var selEnd = textarea ? textarea.selectionEnd : 0;
      var selection = textarea ? textarea.value.slice(selStart, selEnd) : '';

      if (mode === 'selection' && !selection.trim()) {
        say('Highlight the passage you want rewritten first.', 'error');
        if (textarea) textarea.focus();
        return;
      }
      if (mode === 'continue' && textarea && !textarea.value.trim()) {
        say('There is nothing to continue from yet — write an opening, or choose “Post”.', 'error');
        return;
      }
      if (REPLACES_BODY[mode] && textarea && textarea.value.trim()) {
        if (!window.confirm('Replace everything in the editor with the new draft?')) return;
      }

      /* Retire the previous draft's headlines before asking for new ones. */
      clearTitles();

      setBusy(true);
      say(WANTS_IMAGE[mode] && !WRITES_BODY[mode]
        ? 'Drawing the feature image… this can take half a minute.'
        : OFFERS_TITLES[mode] && !WRITES_BODY[mode]
          ? 'Writing the headlines… this can take half a minute.'
          : mode === 'title_post_image'
            ? 'Writing the article, its headlines and a cover image… this can take a minute.'
            : 'Writing… this can take half a minute.', 'info');

      try {
        var response = await fetch('/admin/ai/compose', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
            'x-csrf-token': csrf,
          },
          body: JSON.stringify({
            title: title,
            mode: mode,
            length: lengthSelect ? lengthSelect.value : 'medium',
            tone: toneInput ? toneInput.value : '',
            existing: textarea ? textarea.value.slice(0, 20000) : '',
            selection: selection.slice(0, 10000),
          }),
        });

        var data = await response.json().catch(function () { return {}; });
        if (!response.ok || !data.ok) {
          throw new Error(data.error || 'The assistant returned ' + response.status + '.');
        }

        /*
          Only the modes that write prose touch the editor. In `title` and
          `image` mode the body must survive exactly as the author left it —
          that is the whole point of them being separate options.
        */
        if (WRITES_BODY[mode]) insert(data.markdown, mode, selStart, selEnd);
        renderTitles(OFFERS_TITLES[mode] ? data.titleSuggestions : null);
        var imageApplied = WANTS_IMAGE[mode] ? applyImage(data.image) : false;
        setBusy(false);

        var note = WRITES_BODY[mode]
          ? 'Draft inserted.'
          : mode === 'image' ? 'Feature image ready.' : 'Headlines ready.';
        if (data.diagramsCreated) {
          note += ' Drew ' + data.diagramsCreated + ' diagram' + (data.diagramsCreated === 1 ? '' : 's') + '.';
        }
        if (data.diagramsSkipped) {
          note += ' Skipped ' + data.diagramsSkipped + ' that did not parse.';
        }
        if (OFFERS_TITLES[mode]) {
          var offered = (data.titleSuggestions || []).length;
          note += offered
            ? ' ' + offered + ' headline' + (offered === 1 ? '' : 's') + ' offered below — pick one, or keep your own.'
            : ' The model returned no headlines this time, so the Title field is unchanged.';
        }
        if (WANTS_IMAGE[mode]) {
          if (imageApplied) {
            /*
              Saying which backend drew it is not decoration: the keyless one is
              a public, unauthenticated service, so the subject of an
              unpublished draft left the building when it was used.
            */
            note += data.image.source === 'provider'
              ? ' Cover image drawn by your image model and set as the featured image.'
              : ' Cover image drawn by the free keyless service and set as the featured image.';
          } else {
            note += ' ' + (data.imageNote || 'No feature image came back.');
          }
        }
        say(note, imageApplied || !WANTS_IMAGE[mode] ? 'ok' : 'error');
        if (window.GravyStudio) {
          window.GravyStudio.toast(WRITES_BODY[mode] ? 'AI draft ready.' : mode === 'image' ? 'Feature image ready.' : 'Headlines ready.', 'success');
        }
      } catch (error) {
        setBusy(false);
        var message = (error && error.message) || 'The assistant could not finish.';
        say(message, 'error');
        if (window.GravyStudio) window.GravyStudio.toast(message, 'error');
      }
    }

    button.addEventListener('click', generate);

    /* The picker only means something in the two headline modes. */
    if (modeSelect) {
      modeSelect.addEventListener('change', function () {
        if (!OFFERS_TITLES[modeSelect.value]) clearTitles();
      });
    }

    /*
      Enter in the title field would otherwise submit #editorForm, silently
      saving a half-written post instead of drafting one.
    */
    if (titleInput) {
      titleInput.addEventListener('keydown', function (event) {
        if (event.key === 'Enter') {
          event.preventDefault();
          generate();
        }
      });
    }
  })();
</script>
<% } %>
