<!doctype html>
<html lang="en" data-theme="<%= typeof theme !== 'undefined' ? theme : 'light' %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <% const _site = typeof siteName !== "undefined" ? siteName : "Azure Gravy"; %>
  <title><%= pageTitle %><% if (String(pageTitle).indexOf(_site) === -1) { %> · <%= _site %><% } %></title>
  <meta name="description" content="<%= metaDescription %>">
  <% const _preview = typeof previewMode !== 'undefined' && previewMode; %>
  <% if (!_preview) { %>
  <link rel="canonical" href="<%= settings.site_url || '' %><%= currentPath %>">
  <% } %>
  <meta name="theme-color" content="<%= theme === 'dark' ? '#000000' : '#ffffff' %>">
  <meta property="og:site_name" content="<%= typeof siteName !== "undefined" ? siteName : "Azure Gravy" %>">
  <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>">
  <meta property="og:title" content="<%= pageTitle %>">
  <meta property="og:description" content="<%= metaDescription %>">
  <% if (!_preview) { %>
  <meta property="og:url" content="<%= settings.site_url || '' %><%= currentPath %>">
  <% } %>
  <meta property="og:image" content="<%= ogImage %>">
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= metaDescription %>">
  <meta name="twitter:image" content="<%= ogImage %>">
  <link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
  <link rel="alternate" type="application/rss+xml" title="<%= typeof siteName !== "undefined" ? siteName : "Azure Gravy" %>" href="/feed.xml">
  <link rel="preload" href="/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="/assets/fonts/instrument-serif-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
  <link rel="stylesheet" href="/assets/css/base.css">
  <link rel="stylesheet" href="/assets/css/site.css">
  <%- typeof accentStyles !== 'undefined' ? accentStyles : '' %>
  <script>
    (function () {
      try {
        var stored = localStorage.getItem('gravy-theme');
        var preferred = stored || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : null);
        if (preferred) document.documentElement.dataset.theme = preferred;
      } catch (e) {}
    })();
  </script>
  <%- typeof extraHead !== 'undefined' ? extraHead : '' %>
</head>
<body class="<%= bodyClass %>">
  <a class="skip-link" href="#main">Skip to content</a>
  <% if (_preview && typeof post !== 'undefined' && post) { %>
  <div class="preview-banner" role="status">
    <div class="container preview-banner__inner">
      <span class="preview-banner__badge"><%- h.icon('eye', '', 14) %> Preview</span>
      <p>
        This <strong><%= post.status %></strong> <%= post.type === 'page' ? 'page' : 'story' %>
        is visible only to you and site admins. Visitors cannot reach it, and search
        engines are told to ignore it.
      </p>
      <a class="preview-banner__back" href="/admin/posts/<%= post.id %>/edit">
        <%- h.icon('pen', '', 13) %> Back to editor
      </a>
    </div>
  </div>
  <% } %>
  <div class="reading-progress" id="readingProgress" hidden></div>
  <%- include('../partials/header') %>
  <main id="main" class="page-shell">
    <%- body %>
  </main>
  <%- include('../partials/footer') %>
  <%- include('../partials/search-overlay') %>
  <%- include('../partials/newsletter-popup') %>

  <% if (flash && flash.length) { %>
    <div class="toast-stack" id="toastStack">
      <% flash.forEach(function (item) { %>
        <div class="toast toast--<%= item.type %>" role="status">
          <%- h.icon(item.type === 'error' ? 'alert-circle' : (item.type === 'success' ? 'check-circle' : 'info'), '', 18) %>
          <span><%= item.message %></span>
          <button class="toast__close" data-toast-close aria-label="Dismiss"><%- h.icon('close', '', 14) %></button>
        </div>
      <% }); %>
    </div>
  <% } %>

  <script src="/assets/js/site.js" defer></script>
  <%- typeof extraScripts !== 'undefined' ? extraScripts : '' %>
</body>
</html>
