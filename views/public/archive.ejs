<section class="page-head">
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span>/</span> <span>Archive</span></nav>
    <div class="page-head__inner">
      <div>
        <span class="kicker">Everything, in order</span>
        <h1 style="margin-top:10px">The archive.</h1>
        <p>Every post we have published, grouped by month. A good place to get lost for an afternoon.</p>
      </div>
      <span class="chip chip--accent"><%= months.reduce(function (sum, month) { return sum + Number(month.total); }, 0) %> posts</span>
    </div>
  </div>
</section>

<section class="container">
  <% if (months.length === 0) { %>
    <div class="empty">
      <%- h.icon('book', 'empty__icon', 44) %>
      <h3>The archive is empty</h3>
      <p>The first post will appear here as soon as it is published.</p>
      <a class="btn btn--ghost" href="<%= h.postListUrl %>">Browse posts</a>
    </div>
  <% } else { %>
    <div class="archive-grid">
      <% months.forEach(function (month) { %>
        <div class="archive-month">
          <div class="archive-month__head">
            <h2><%= month.label %></h2>
            <span class="muted small"><%= month.total %> stor<%= Number(month.total) === 1 ? 'y' : 'ies' %></span>
          </div>
          <ul class="archive-list">
            <% month.posts.forEach(function (post) { %>
              <li>
                <time datetime="<%= h.isoDate(post.published_at) %>"><%= h.formatDate(post.published_at, 'short') %></time>
                <a href="<%= h.postUrl(post) %>"><%= post.title %></a>
                <% if (post.category_slug) { %>
                  <a class="chip" href="/category/<%= post.category_slug %>"><%= post.category_name %></a>
                <% } %>
              </li>
            <% }); %>
          </ul>
          <% if (Number(month.total) > month.posts.length) { %>
            <a class="section-head__link" href="<%= h.postListUrl %>?month=<%= month.ym %>">All <%= month.total %> from <%= month.label %> <%- h.icon('arrow-right', '', 13) %></a>
          <% } %>
        </div>
      <% }); %>
    </div>
  <% } %>
</section>
