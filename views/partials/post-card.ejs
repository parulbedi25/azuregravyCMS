<%
  const _variant = typeof variant !== 'undefined' ? variant : 'default';
  const _showExcerpt = typeof showExcerpt !== 'undefined' ? showExcerpt : true;
  const _cover = h.coverUrl(post);
  const _catName = post.category_name || 'Story';
  const _catSlug = post.category_slug || null;
%>
<article class="post-card <%= _variant === 'feature' ? 'post-card--feature' : '' %> <%= _variant === 'row' ? 'post-card--row' : '' %> <%= _variant === 'mini' ? 'post-card--mini' : '' %>" <%- typeof reveal !== 'undefined' ? 'data-reveal style="--reveal-delay:' + (typeof delay !== 'undefined' ? delay : 0) + 'ms"' : '' %>>
  <a class="post-card__media" href="<%= h.postUrl(post) %>" aria-hidden="true" tabindex="-1">
    <% if (_cover) { %>
      <img src="<%= _cover %>" alt="" loading="lazy" decoding="async">
    <% } else { %>
      <span class="post-card__placeholder" style="background-color: <%= h.colorFromSeed(post.slug) %>; background-image: linear-gradient(135deg, <%= h.colorFromSeed(post.slug) %>, color-mix(in srgb, <%= h.colorFromSeed(post.slug) %> 55%, #0b0c0f))">
        <span class="serif"><%= post.title.slice(0, 1) %></span>
      </span>
    <% } %>
    <% if (_catSlug) { %><span class="chip"><%= _catName %></span><% } %>
    <% if (post.reading_time) { %>
      <span class="post-card__read"><%- h.icon('clock', '', 12) %> <%= post.reading_time %> min read</span>
    <% } %>
  </a>
  <div class="post-card__body">
    <% if (_catSlug && _variant === 'mini') { %><span class="post-card__cat"><%= _catName %></span><% } %>
    <h3><a href="<%= h.postUrl(post) %>"><%= post.title %></a></h3>
    <% if (_showExcerpt && _variant !== 'mini' && (post.excerpt || post.content)) { %>
      <p><%= h.excerptOf(post, _variant === 'feature' ? 210 : 140) %></p>
    <% } %>
    <div class="post-meta">
      <a href="/author/<%= post.author_id %>" class="post-meta__author"><%= post.author_name || 'Azure Gravy' %></a>
      <span class="dot"></span>
      <time datetime="<%= h.isoDate(post.published_at || post.created_at) %>"><%= h.formatDate(post.published_at || post.created_at, 'medium') %></time>
      <% if (typeof post.comment_count !== 'undefined' && post.comment_count > 0) { %>
        <span class="dot"></span>
        <span><%= post.comment_count %> comment<%= post.comment_count === 1 ? '' : 's' %></span>
      <% } %>
    </div>
  </div>
</article>
