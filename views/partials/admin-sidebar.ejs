<%
  const nav = [
    { group: 'Overview', items: [
      { key: 'dashboard', label: 'Dashboard', url: '/admin', icon: 'home' },
    ]},
    { group: 'Content', items: [
      { key: 'posts', label: 'Posts', url: '/admin/posts', icon: 'file-text', count: navCounts.drafts || 0 },
      { key: 'pages', label: 'Pages', url: '/admin/posts?type=page', icon: 'files' },
      { key: 'categories', label: 'Categories', url: '/admin/categories', icon: 'layout' },
      { key: 'tags', label: 'Tags', url: '/admin/tags', icon: 'tag' },
      { key: 'media', label: 'Media', url: '/admin/media', icon: 'image' },
    ]},
    { group: 'Community', items: [
      { key: 'comments', label: 'Comments', url: '/admin/comments', icon: 'comment', count: navCounts.pending || 0, hot: true, editorOnly: true },
      { key: 'subscribers', label: 'Subscribers', url: '/admin/subscribers', icon: 'mail', adminOnly: true },
      { key: 'messages', label: 'Inbox', url: '/admin/messages', icon: 'message-square', count: navCounts.unread || 0, adminOnly: true },
    ]},
    { group: 'Publication', items: [
      { key: 'appearance', label: 'Appearance', url: '/admin/appearance', icon: 'palette', adminOnly: true },
      { key: 'menus', label: 'Navigation', url: '/admin/menus', icon: 'list', editorOnly: true },
      { key: 'permalinks', label: 'Permalinks', url: '/admin/permalinks', icon: 'link', adminOnly: true },
      { key: 'redirects', label: 'Redirects', url: '/admin/redirects', icon: 'corner-down-right', editorOnly: true },
      { key: 'ai', label: 'AI assistant', url: '/admin/ai', icon: 'sparkles', adminOnly: true },
      { key: 'settings', label: 'Settings', url: '/admin/settings', icon: 'settings', adminOnly: true },
      { key: 'users', label: 'People', url: '/admin/users', icon: 'users', adminOnly: true },
      { key: 'tools', label: 'System', url: '/admin/tools', icon: 'database', adminOnly: true },
    ]},
  ];

  /*
    Sidebar on/off state for the AI assistant.

    Read through `h.aiStatus` rather than straight from settings, because the
    readiness rule lives in one place now: a keyless provider is configured, and
    testing `settings.ai_api_key` here used to label it "needs a key" no matter
    what the settings page said. Still no extra query — the helpers are built
    from the settings already loaded for this request.

    Only the boolean and the model name reach the markup — never the key.
  */
  const ai = h.aiStatus;
  const aiOn = ai.on;
  const aiStatus = !aiOn ? 'Off' : (ai.ready ? 'On · ' + ai.model : 'On · needs setup');
%>
<aside class="sidebar" id="sidebar">
  <div class="sidebar__brand">
    <a class="brand" href="/admin">
      <span class="brand__mark"><%= h.setting('logo_text', 'G').slice(0, 1) %></span>
      <span class="brand__name"><%= h.setting('logo_text', siteName) %></span>
    </a>
    <span class="badge-studio">Studio</span>
    <button class="icon-btn sidebar__close" type="button" data-close-sidebar aria-label="Close menu" style="border:0;background:transparent;color:#a7adbb"><%- h.icon('close', '', 16) %></button>
  </div>

  <div class="sidebar__scroll">
    <% nav.forEach(function (section) { %>
      <div class="nav-group">
        <div class="nav-group__title"><span><%= section.group %></span></div>
        <% section.items.forEach(function (item) { %>
          <% if (item.adminOnly && !can.admin) return; %>
          <% if (item.editorOnly && !can.editor) return; %>
          <a href="<%= item.url %>" class="<%= page === item.key ? 'is-active' : '' %>">
            <%- h.icon(item.icon) %>
            <span><%= item.label %></span>
            <% if (item.count) { %><span class="nav-group__count <%= item.hot ? 'nav-group__count--hot' : '' %>"><%= item.count %></span><% } %>
          </a>
        <% }); %>
      </div>
    <% }); %>

    <div class="nav-group" style="margin-bottom: 4px">
      <div class="nav-group__title"><span>Shortcuts</span></div>
      <a href="/admin/posts/new"><%- h.icon('plus') %><span>New post</span></a>
      <a href="/admin/media"><%- h.icon('upload') %><span>Upload media</span></a>
      <a href="/" target="_blank" rel="noopener"><%- h.icon('external') %><span>View site</span></a>
    </div>

    <% if (can.admin) { %>
      <%
        /*
          Enable or disable the AI assistant on demand, without leaving the page.

          This is a real <form> (the sidebar is a sibling of the page body, not
          nested inside #editorForm, so it cannot trigger the duplicate-_csrf
          recovery that caused the publish-419 bug). admin.js upgrades it to a
          fetch and hides the Apply button; without JS the button still works.
        */
      %>
      <div class="nav-group sidebar-ai">
        <div class="nav-group__title"><span>AI assistant</span></div>
        <form method="post" action="/admin/ai/toggle" class="sidebar-ai__form" data-ai-toggle>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="redirect" value="<%= currentPath %>">
          <label class="switch switch--rail">
            <input type="checkbox" name="enabled" value="1" data-ai-switch <%= aiOn ? 'checked' : '' %>>
            <span class="switch__track"></span>
            <span class="switch__text">
              <b data-ai-label><%= aiOn ? 'Enabled' : 'Disabled' %></b>
              <span data-ai-status><%= aiStatus %></span>
            </span>
          </label>
          <button class="sidebar-ai__apply" type="submit">Apply</button>
        </form>
      </div>
    <% } %>
  </div>

  <div class="sidebar__foot">
    <div class="sidebar-user">
      <%- include('../partials/avatar', { avatar: currentUser.avatar, name: currentUser.name }) %>
      <span class="sidebar-user__meta">
        <b><%= currentUser.name %></b>
        <span><%= currentUser.role %></span>
      </span>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="icon-btn" type="submit" aria-label="Sign out" title="Sign out"><%- h.icon('log-out', '', 15) %></button>
      </form>
    </div>
  </div>
</aside>
