{
  "name": "gravy-cms",
  "version": "1.1.0",
  "private": true,
  "description": "Gravy CMS — a complete editorial blogging CMS built with Node.js, TypeScript, Express and MariaDB.",
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start:prod": "node dist/server.js",
    "db:setup": "tsx src/db/setup-cli.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/seed.ts --reset",
    "typecheck": "tsc --noEmit"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  },
  "keywords": [
    "cms",
    "blog",
    "typescript",
    "mariadb",
    "mysql",
    "express",
    "cpanel"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.8",
    "ejs": "^7.0.2",
    "express": "^4.22.3",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.19.0",
    "image-size": "^2.0.2",
    "marked": "^18.1.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "sanitize-html": "^2.18.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "lite4mariadb": "^0.1.2"
  },
  "devDependencies": {
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.23",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/express-session": "^1.19.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.18.0",
    "@types/sanitize-html": "^2.16.2",
    "typescript": "^5.7.3"
  }
}
