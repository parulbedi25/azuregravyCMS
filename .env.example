# ─────────────────────────────────────────────────────────────────────────────
#  Azure Gravy CMS — configuration
#
#  OPTIONAL. The app starts with no `.env` at all: open it in a browser and the
#  installer at /admin/setup asks for the database, tests it, builds the tables
#  and creates your administrator account.
#
#  Copy this file to `.env` only if you prefer to configure things up front
#  (cPanel environment panel, Docker, CI). Environment values always win over
#  what the installer saved in data/install.json.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# On cPanel/Passenger leave PORT unset — Passenger provides it (sometimes as a
# unix socket path, which the app understands).
PORT=3000
NODE_ENV=production

# Public address of the site, used for canonical links, Open Graph, RSS, sitemap.
# Leave blank to detect it from the incoming request (works on any hostname).
SITE_URL=

# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-please-use-a-long-random-string

# Session cookie SameSite attribute: lax (default), strict, or none.
#
# Leave this blank unless the Studio is embedded in an iframe on a DIFFERENT
# site. A cross-site iframe makes every request cross-site, and browsers
# withhold a `lax` cookie from those entirely — so the session never survives
# to the next request and every form submit dies with "419 Session expired".
#
# `none` makes the cookie cross-site-capable. It requires HTTPS (the app forces
# the Secure flag in this mode) and it weakens the browser's own CSRF defence,
# so do NOT set it for a normal top-level site — the CSRF token check still
# applies either way, but `lax` is the better default.
SESSION_SAMESITE=

# ── Database (MariaDB / MySQL) ───────────────────────────────────────────────
# Leave ALL of these blank to be asked by the installer instead — that is the
# normal path and it needs no restart.
#
# If you do fill them in: create the database and user in cPanel → MySQL®
# Databases first, and copy the FULL names — cPanel prefixes them with your
# account name, e.g. database `myaccount_gravy`, user `myaccount_gravy`.
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=myaccount_gravy
DB_USER=myaccount_gravy
DB_PASSWORD=your-database-password

# Some hosts require TLS for remote MySQL. Local cPanel connections do not.
DB_SSL=false

# Milliseconds to wait for the server to answer (default 12000).
# DB_CONNECT_TIMEOUT=12000

# Alternative to the five values above — one URL instead:
# DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD are ignored when set.
# DATABASE_URL=mysql://myaccount_gravy:password@localhost:3306/myaccount_gravy

# ── First-run setup ──────────────────────────────────────────────────────────
# Tables, settings, menus and starter pages are always created automatically —
# on the first request, never at boot.
#
# Set SEED_DEMO=1 to load the full demo publication (18 stories, 6 writers) on an
# empty database. Leave it 0 for a real site.
SEED_DEMO=0

# Optional: create the super admin from here instead of using the installer.
# Leave both blank to be asked for them in the browser at /admin/setup.
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_MAX_MB=12

# ── Local development only ───────────────────────────────────────────────────
# DB_DRIVER=embedded runs MariaDB compiled to WebAssembly inside Node — no
# database server needed. The installer offers the same thing as
# "Built-in MariaDB on this machine". Requires the optional `lite4mariadb`
# package, which `npm install` already fetches.
# DB_DRIVER=embedded
# DB_DATA_DIR=./data/mariadb

# ── Files the app writes ─────────────────────────────────────────────────────
#   data/install.json    database details saved by the installer (mode 0600)
#   data/mariadb/        embedded driver's database files
#   public/uploads/      media library
# All three are git-ignored. Delete data/install.json to run the installer again.
