# ─────────────────────────────────────────────────────────────────────────────
#  Azure Gravy CMS — configuration
#  Copy this file to `.env` and fill in the database details from cPanel.
#  Everything else has a working default.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# On cPanel/Passenger leave PORT unset — Passenger provides it.
PORT=3000
NODE_ENV=production

# Public address of the site, used for canonical links, Open Graph, RSS, sitemap.
# Leave blank to detect it from the incoming request (works on any hostname).
SITE_URL=

# REQUIRED in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-please-use-a-long-random-string

# ── Database (MariaDB / MySQL) ───────────────────────────────────────────────
# Create the database and user in cPanel → MySQL® Databases, then copy the
# FULL names here — cPanel prefixes them with your account name, e.g.
#   database: myaccount_gravy     user: myaccount_gravy
DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=myaccount_gravy
DB_USER=myaccount_gravy
DB_PASSWORD=your-database-password

# Some hosts require TLS for remote MySQL. Local cPanel connections do not.
DB_SSL=false

# Alternative to the five values above — one URL instead:
# DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD are ignored when set.
# DATABASE_URL=mysql://myaccount_gravy:password@localhost:3306/myaccount_gravy

# ── First-run setup ──────────────────────────────────────────────────────────
# Tables, settings, menus and starter pages are always created automatically.
# Set SEED_DEMO=1 to load the full demo publication (18 stories, 6 writers) on an
# empty database. Leave it 0 for a real site.
SEED_DEMO=0

# Optional: create the super admin from here instead of using the /admin/setup
# wizard. Leave both blank to get the wizard on first visit.
ADMIN_NAME=Site Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Uploads ──────────────────────────────────────────────────────────────────
UPLOAD_MAX_MB=12

# ── Local development only ───────────────────────────────────────────────────
# DB_DRIVER=embedded runs MariaDB compiled to WebAssembly inside Node — no
# database server needed. Requires `npm install lite4mariadb`.
# DB_DRIVER=embedded
# DB_DATA_DIR=./data/mariadb
