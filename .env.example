# ── Server ────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Public URL of the site (used in RSS, sitemap, canonical links)
SITE_URL=http://localhost:3000
# Replace with a long random string in production
SESSION_SECRET=change-me-please-use-a-long-random-string

# ── Database ──────────────────────────────────────────────────────────────
# "embedded" runs a real MariaDB engine compiled to WebAssembly, inside Node.
# It is perfect for demos, local development and small single-node sites.
# "mysql" talks to a MariaDB / MySQL server over the wire (recommended for
# production and for multi-instance deployments).
DB_DRIVER=embedded

# Used when DB_DRIVER=embedded
DB_DATA_DIR=./data/mariadb
DB_NAME=azuregravy

# Used when DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=azuregravy
DB_PASSWORD=azuregravy
# DB_NAME=azuregravy

# ── Seeding ───────────────────────────────────────────────────────────────
# Credentials created by `npm run db:seed`
ADMIN_EMAIL=admin@azuregravy.local
ADMIN_PASSWORD=gravy123
